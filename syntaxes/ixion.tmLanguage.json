{
  "scopeName": "source.ixion",
  "name": "Ixion",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#lambda" },
    { "include": "#case" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ixion",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.ixion",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.ixion",
      "match": "\\b(pub|def|type|var|const|use|if|else|for|while|return|case|lambda|struct|enum|true|false)\\b"
    },
    "types": {
      "name": "support.type.ixion",
      "match": "\\b(int|float|double|string|bool|any|void)\\b"
    },
    "strings": {
      "name": "string.quoted.double.ixion",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "include": "#string_escapes" }]
    },
    "string_escapes": {
      "name": "constant.character.escape.ixion",
      "match": "\\\\."
    },
    "numbers": {
      "name": "constant.numeric.ixion",
      "match": "\\b(0x[0-9a-fA-F]+|\\d+(\\.\\d+)?([eE][+-]?\\d+)?[fF]?|\\d+)\\b"
    },
    "operators": {
      "name": "keyword.operator.ixion",
      "match": "(\\+\\+|--|=>|==|!=|>=|<=|&&|\\|\\||\\+|-|\\*|/|%|\\||&|=|->|::)"
    },
    "lambda": {
      "name": "keyword.control.lambda.ixion",
      "begin": "\\blambda\\b",
      "end": "\\{",
      "patterns": [{ "include": "#types" }]
    },
    "case": {
      "begin": "\\bcase\\b",
      "end": "\\{",
      "name": "keyword.control.case.ixion",
      "patterns": [{ "include": "#keywords" }, { "include": "#types" }]
    }
  }
}
